    {
      "label": "Vallion: Refresh data from Liquipedia",
      "type": "shell",
      "command": "python pipeline/build.py",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Vallion: Rebuild answers (no download)",
      "type": "shell",
      "command": "python pipeline/build.py --offline",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
